# Copy to .env.local (browser-safe values, read by Vite) and to .dev.vars (server-only values, read by wrangler).
# Never commit either copy.

# --- Browser (Vite). Safe to expose: protected by Row Level Security. ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
# Set to 1 to build the portfolio demo (in-memory fictional data, no keys needed).
VITE_DEMO=

# --- Server only (.dev.vars locally, Cloudflare Pages secrets in production). ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM="Maria Blair <maria@mariablairai.com>"
ADMIN_NOTIFY_EMAIL=
TURNSTILE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_SITE_URL=http://localhost:5173
