# Copy to .env.local (browser-safe values, read by Vite) and to .dev.vars (server-only values, read by wrangler).
# Never commit either copy.

# --- Browser (Vite). Safe to expose: protected by Row Level Security. ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
# Set to 1 to build the portfolio demo (in-memory fictional data, no keys needed).
VITE_DEMO=

# --- Server only (.dev.vars locally, Cloudflare Pages secrets in production). ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM="Maria Blair <maria@mariablairai.com>"
ADMIN_NOTIFY_EMAIL=
TURNSTILE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_SITE_URL=http://localhost:5173


# Google Sheets sync (server only). Leave off; never paste actual values in this example.
# Supported after separately approved testing/setup: preview or sheet_to_app. No Google writes.
CRM_SHEETS_SYNC_MODE=off
CRM_SHEETS_SYNC_ID=
CRM_SHEETS_SYNC_ACCOUNT=
CRM_SHEETS_SYNC_KEY=

# Optional first import, server-only. No Google account/token is needed.
# With sync off, configure the same connection digest as the database singleton.
CRM_SHEETS_BOOTSTRAP_ENABLED=0
CRM_SHEETS_BOOTSTRAP_CONNECTION=

# Direct first import from the same private Google workbook; independently enabled.
# Requires the Google read credentials above and the existing bootstrap RPC/connection.
# Creates new app records only; linked edits still use CRM_SHEETS_SYNC_MODE.
CRM_SHEETS_GOOGLE_IMPORT_ENABLED=0
